[worldserver]

########################################
# mod-temucraft-starting-zone
########################################
#
#    Temucraft.StartingZone.Enable
#        Description: A new character is asked where to begin: its own race's starting zone or another one. The
#                     choice also sets the hearthstone. .temucraft startzone asks again (up to MaxLevel). Death knights keep
#                     their own start. The starting-zone quests are opened to the whole faction (module SQL).
#        Default:     1

Temucraft.StartingZone.Enable = 1

#
#    Temucraft.StartingZone.AnyFaction
#        Description: 1 = the other faction's starting zones are offered too.
#        Default:     0

Temucraft.StartingZone.AnyFaction = 0

#
#    Temucraft.StartingZone.MaxLevel
#        Description: Highest level at which .temucraft startzone still works.
#        Default:     5

Temucraft.StartingZone.MaxLevel = 5

#
#    Temucraft.StartingZone.Enforce
#        Description: 1 = a new character must pick: the window comes back a few seconds after it is closed (the gossip
#                     menu of a client without the window: every 45 seconds), and again at the next login, until a zone
#                     is picked ("Stay in ..." counts). Once picked it is never asked again. 0 = asked once.
#        Default:     1

Temucraft.StartingZone.Enforce = 1
